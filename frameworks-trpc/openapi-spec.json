{
  "openapi": "3.1.0",
  "info": {
    "title": "Train Travel API",
    "description": "API for finding and booking train trips across Europe.",
    "version": "1.2.1",
    "contact": {
      "name": "Train Support",
      "url": "https://example.com/support",
      "email": "support@example.com"
    },
    "license": {
      "name": "Creative Commons Attribution-NonCommercial-ShareAlike 4.0 International",
      "url": "https://creativecommons.org/licenses/by-nc-sa/4.0/"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3123/api",
      "description": "Local Development"
    },
    {
      "url": "https://api.example.com/api",
      "description": "Production"
    }
  ],
  "tags": [
    {
      "name": "Stations",
      "description": "Find and filter train stations across Europe, including location and local timezone."
    },
    {
      "name": "Trips",
      "description": "Timetables and routes for train trips between stations, including pricing and availability."
    },
    {
      "name": "Bookings",
      "description": "Create and manage bookings for train trips, including passenger details and optional extras."
    },
    {
      "name": "Payments",
      "description": "Pay for bookings using a card or bank account, and view payment status and history."
    }
  ],
  "paths": {
    "/stations": {
      "get": {
        "operationId": "getStations",
        "summary": "Get a list of train stations",
        "description": "Returns a paginated and searchable list of all train stations.",
        "tags": [
          "Stations"
        ],
        "security": [
          {
            "OAuth2": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "number",
              "description": "Page number to return",
              "example": 1
            }
          },
          {
            "in": "query",
            "name": "search",
            "schema": {
              "type": "string",
              "description": "Filter stations by name or address",
              "example": "Berlin"
            }
          },
          {
            "in": "query",
            "name": "country",
            "schema": {
              "type": "string",
              "description": "Filter stations by ISO 3166-1 alpha-2 country code",
              "example": "DE"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid",
                            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                            "description": "Unique station ID",
                            "example": "efdbb9d1-02c2-4bc3-afb7-6788d8782b1e"
                          },
                          "name": {
                            "type": "string",
                            "description": "Name of the station",
                            "example": "Berlin Hauptbahnhof"
                          },
                          "address": {
                            "type": "string",
                            "description": "Street address of the station",
                            "example": "Invalidenstrasse 10557 Berlin, Germany"
                          },
                          "country_code": {
                            "type": "string",
                            "description": "ISO 3166-1 alpha-2 country code",
                            "example": "DE"
                          },
                          "timezone": {
                            "type": "string",
                            "description": "IANA timezone of the station",
                            "example": "Europe/Berlin"
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "address",
                          "country_code"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid input data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error.BAD_REQUEST"
                }
              }
            }
          },
          "401": {
            "description": "Authorization not provided",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error.UNAUTHORIZED"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error.FORBIDDEN"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error.NOT_FOUND"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error.INTERNAL_SERVER_ERROR"
                }
              }
            }
          }
        }
      }
    },
    "/trips": {
      "get": {
        "operationId": "getTrips",
        "summary": "Get available train trips",
        "description": "Returns a list of available train trips between two stations on a given date.",
        "tags": [
          "Trips"
        ],
        "security": [
          {
            "OAuth2": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "origin",
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "ID of the origin station",
              "example": "efdbb9d1-02c2-4bc3-afb7-6788d8782b1e"
            },
            "required": true,
            "description": "ID of the origin station"
          },
          {
            "in": "query",
            "name": "destination",
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "ID of the destination station",
              "example": "b2e783e1-c824-4d63-b37a-d8d698862f1d"
            },
            "required": true,
            "description": "ID of the destination station"
          },
          {
            "in": "query",
            "name": "date",
            "schema": {
              "type": "string",
              "description": "Travel date in YYYY-MM-DD format",
              "example": "2024-02-01"
            },
            "required": true,
            "description": "Travel date in YYYY-MM-DD format"
          },
          {
            "in": "query",
            "name": "bicycles",
            "schema": {
              "type": "boolean",
              "description": "Only return trips that allow bicycles",
              "example": true
            }
          },
          {
            "in": "query",
            "name": "dogs",
            "schema": {
              "type": "boolean",
              "description": "Only return trips that allow dogs",
              "example": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid",
                            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                            "description": "Unique trip ID",
                            "example": "ea399ba1-6d95-433f-92d1-83f67b775594"
                          },
                          "origin": {
                            "type": "string",
                            "format": "uuid",
                            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                            "description": "ID of the origin station",
                            "example": "efdbb9d1-02c2-4bc3-afb7-6788d8782b1e"
                          },
                          "destination": {
                            "type": "string",
                            "format": "uuid",
                            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                            "description": "ID of the destination station",
                            "example": "b2e783e1-c824-4d63-b37a-d8d698862f1d"
                          },
                          "departure_time": {
                            "type": "string",
                            "description": "Departure time in ISO 8601 format",
                            "example": "2024-02-01T10:00:00Z"
                          },
                          "arrival_time": {
                            "type": "string",
                            "description": "Arrival time in ISO 8601 format",
                            "example": "2024-02-01T16:00:00Z"
                          },
                          "price": {
                            "type": "number",
                            "description": "Ticket price in euros",
                            "example": 50
                          },
                          "operator": {
                            "type": "string",
                            "description": "Train operator name",
                            "example": "Deutsche Bahn"
                          },
                          "bicycles_allowed": {
                            "type": "boolean",
                            "description": "Whether bicycles are permitted",
                            "example": true
                          },
                          "dogs_allowed": {
                            "type": "boolean",
                            "description": "Whether dogs are permitted",
                            "example": true
                          }
                        },
                        "required": [
                          "id",
                          "origin",
                          "destination",
                          "departure_time",
                          "arrival_time",
                          "price",
                          "operator",
                          "bicycles_allowed",
                          "dogs_allowed"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid input data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error.BAD_REQUEST"
                }
              }
            }
          },
          "401": {
            "description": "Authorization not provided",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error.UNAUTHORIZED"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error.FORBIDDEN"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error.NOT_FOUND"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error.INTERNAL_SERVER_ERROR"
                }
              }
            }
          }
        },
        "x-speakeasy-name-override": "searchTrips",
        "x-speakeasy-retries": {
          "strategy": "backoff",
          "backoff": {
            "initialInterval": 500,
            "maxInterval": 60000,
            "maxElapsedTime": 3600000,
            "exponent": 1.5
          },
          "statusCodes": [
            "5XX"
          ],
          "retryConnectionErrors": true
        }
      }
    },
